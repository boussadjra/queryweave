{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "plugins": ["typescript", "vue", "vitest", "promise", "import"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "rules": {
    "typescript/no-unsafe-type-assertion": "off"
  },
  "overrides": [
    {
      "files": ["tests/types/**/*.test-d.ts"],
      "rules": {
        "vitest/expect-expect": "off"
      }
    },
    {
      "files": ["**/scripts/**", "fixtures/**"],
      "rules": {
        "no-await-in-loop": "off",
        "no-underscore-dangle": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.astro/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/.claude/settings.local.json"
  ]
}
