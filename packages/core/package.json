{
  "name": "@queryweave/core",
  "version": "0.1.0-beta.2",
  "description": "Framework-independent domain contracts for QueryWeave.",
  "keywords": [
    "framework-independent",
    "query",
    "state",
    "typescript",
    "url"
  ],
  "homepage": "https://github.com/boussadjra/queryweave#readme",
  "bugs": {
    "url": "https://github.com/boussadjra/queryweave/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boussadjra/queryweave.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test:types": "tsc -p tsconfig.json",
    "package:check": "publint --strict && attw --pack . --profile esm-only",
    "clean": "node ../../scripts/clean-package.mjs"
  },
  "devDependencies": {
    "@queryweave/typescript-config": "workspace:*"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
