{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": ["pnpm"],
      "ignore": ["fixtures/**"]
    },
    "apps/docs": {
      "entry": [
        "scripts/*.mjs",
        "src/components/**/*.astro",
        "src/components/**/*.vue",
        "src/data/*.ts",
        "src/diagrams/*.ts",
        "src/simulator/*.ts"
      ],
      "project": ["**/*.{astro,mjs,ts,vue}"]
    }
  }
}
