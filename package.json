{
  "name": "queryweave",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Framework-independent, type-safe URL state infrastructure.",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project core --project runtime --project testing --project standard-schema --project vue --project vue-router --project repository",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project server --project node --project nuxt",
    "test:types": "vitest run --project types",
    "test:coverage": "vitest run --coverage",
    "boundary:check": "node scripts/check-boundaries.mjs",
    "check": "oxfmt --check . && oxlint . && tsc -p tsconfig.json && turbo run typecheck && vitest run --coverage && vitest run --project browser && turbo run build --filter=!@queryweave/docs && node scripts/update-bundle-sizes.mjs --check && node scripts/check-boundaries.mjs && turbo run package:check && node scripts/check-artifacts.mjs && turbo run docs:build --filter=@queryweave/docs && knip --include files,dependencies,unlisted,binaries,unresolved,exports,types,nsExports,nsTypes,duplicates",
    "package:check": "turbo run package:check",
    "docs:dev": "turbo run dev --filter=@queryweave/docs",
    "docs:build": "turbo run docs:build --filter=@queryweave/docs",
    "changeset": "changeset",
    "version": "changeset version",
    "version:set": "node scripts/version.mjs",
    "version:alpha": "node scripts/version.mjs prerelease --preid alpha",
    "version:beta": "node scripts/version.mjs prerelease --preid beta",
    "version:rc": "node scripts/version.mjs prerelease --preid rc",
    "license:sync": "node scripts/sync-license.mjs",
    "license:check": "node scripts/sync-license.mjs --check",
    "publish:packages": "node scripts/publish.mjs",
    "release": "turbo run build && turbo run package:check && node scripts/publish.mjs",
    "knip": "knip --include files,dependencies,unlisted,binaries,unresolved,exports,types,nsExports,nsTypes,duplicates",
    "clean": "turbo run clean && node scripts/clean.mjs",
    "artifacts:check": "node scripts/check-artifacts.mjs",
    "bundle:size": "turbo run build --filter=./packages/* && node scripts/update-bundle-sizes.mjs",
    "bundle:size:check": "node scripts/update-bundle-sizes.mjs --check",
    "consumers:check": "node scripts/check-consumers.mjs",
    "check:release": "pnpm check && pnpm consumers:check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:tooling",
    "@changesets/cli": "catalog:tooling",
    "@nuxt/kit": "catalog:nuxt",
    "@playwright/test": "catalog:testing",
    "@queryweave/browser": "workspace:*",
    "@queryweave/core": "workspace:*",
    "@queryweave/node": "workspace:*",
    "@queryweave/nuxt": "workspace:*",
    "@queryweave/server": "workspace:*",
    "@queryweave/standard-schema": "workspace:*",
    "@queryweave/testing": "workspace:*",
    "@queryweave/vue": "workspace:*",
    "@queryweave/vue-router": "workspace:*",
    "@standard-schema/spec": "catalog:validation",
    "@types/node": "catalog:node",
    "@vitest/browser": "catalog:testing",
    "@vitest/browser-playwright": "catalog:testing",
    "@vitest/coverage-v8": "catalog:testing",
    "arktype": "catalog:validation",
    "esbuild": "catalog:tooling",
    "knip": "catalog:tooling",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "oxlint-tsgolint": "catalog:tooling",
    "playwright": "catalog:testing",
    "pnpm": "catalog:tooling",
    "publint": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:tooling",
    "valibot": "catalog:validation",
    "vitest": "catalog:testing",
    "vue": "catalog:vue",
    "vue-router": "catalog:vue",
    "zod": "catalog:validation"
  },
  "engines": {
    "node": ">=22.13.0 <25",
    "pnpm": "11.17.0"
  },
  "packageManager": "pnpm@11.17.0"
}
