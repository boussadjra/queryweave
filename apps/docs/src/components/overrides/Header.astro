---
import Search from "@astrojs/starlight/components/Search.astro";
import { ArrowUpRight } from "@lucide/astro";
import { Icon } from "@astrojs/starlight/components";
import ThemeSelect from "../ThemeSelect.astro";

const reference = Astro.url.pathname.startsWith("/reference/");
---

<div class="qw-header">
  <a class="qw-docs-brand" href="/" aria-label="QueryWeave home"><img src="/queryweavelogo.svg" alt="QueryWeave" width="1830" height="530" /></a>
  <nav class="qw-sections print:hidden" aria-label="Documentation sections">
    <a href="/start/" aria-current={!reference ? "true" : undefined}>Docs</a>
    <a href="/reference/" aria-current={reference ? "true" : undefined}>API</a>
    <a href="/#url-lab">URL lab <ArrowUpRight size={13} aria-hidden="true" /></a>
  </nav>
  <div class="qw-search print:hidden"><Search /></div>
  <div class="qw-utilities print:hidden">
    <a class="qw-github" href="https://github.com/boussadjra/queryweave" aria-label="QueryWeave on GitHub"><Icon name="github" size="1.2rem" /></a>
    <ThemeSelect />
  </div>
</div>

<style>
  .qw-header { display: flex; align-items: center; gap: 1.5rem; height: 100%; min-width: 0; }
  .qw-docs-brand { display: flex; align-items: center; min-height: 44px; flex-shrink: 0; }
  .qw-docs-brand img { width: 154px; height: auto; }
  :global([data-theme="dark"]) .qw-docs-brand img { filter: brightness(2.7) saturate(0.65); }
  .qw-sections { display: flex; gap: 1.5rem; height: 100%; }
  .qw-sections a { position: relative; display: flex; align-items: center; gap: 0.3rem; min-height: 44px; white-space: nowrap; font-size: 0.8125rem; font-weight: 500; text-decoration: none; color: var(--qw-muted); }
  .qw-sections a:hover { color: var(--qw-heading); }
  .qw-sections a[aria-current] { color: var(--qw-heading); }
  .qw-sections a[aria-current]::after { content: ""; position: absolute; inset-inline: 0; bottom: 0; height: 2px; background: var(--qw-accent); }
  .qw-search { display: flex; justify-content: flex-end; flex: 1; min-width: 0; }
  .qw-search :global(site-search) { width: min(100%, 22rem); }
  .qw-search :global(button[data-open-modal]) { min-height: 44px; }
  .qw-utilities { display: flex; align-items: center; gap: 0.75rem; }
  .qw-github { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: var(--qw-muted); }
  .qw-github:hover { color: var(--qw-heading); }
  @media (max-width: 64rem) { .qw-sections { display: none; } }
  @media (max-width: 49.99rem) {
    .qw-header { gap: 0.5rem; }
    .qw-docs-brand img { width: 132px; }
    .qw-search :global(site-search) { width: auto; }
    .qw-github { display: none; }
    .qw-utilities { gap: 0; }
  }
  @media (max-width: 23rem) {
    .qw-docs-brand img { width: 110px; }
    .qw-header { gap: 0.15rem; }
  }
  @media (max-width: 30rem) {
    .qw-utilities :global(select) { width: 44px; padding: 0; font-size: 0; }
    .qw-utilities :global(option) { font-size: 0.875rem; }
    .qw-utilities :global(.theme-icon) { inset-inline-start: 13px; }
    .qw-utilities :global(.theme-caret) { display: none; }
  }
</style>
