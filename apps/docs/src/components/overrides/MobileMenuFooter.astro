---
import { ArrowUpRight } from "@lucide/astro";
import { Icon } from "@astrojs/starlight/components";
---

<nav class="qw-menu-links" aria-label="Project links">
  <a href="/#url-lab">Try the URL lab <ArrowUpRight size={16} aria-hidden="true" /></a>
  <a href="https://github.com/boussadjra/queryweave"><Icon name="github" size="1rem" />GitHub</a>
</nav>

<style>
  .qw-menu-links { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--qw-panel-border); }
  a { display: flex; align-items: center; gap: 0.5rem; min-height: 44px; font-size: 0.8125rem; color: var(--qw-accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
