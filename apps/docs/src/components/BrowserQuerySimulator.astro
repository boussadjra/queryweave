---
import { findMode, presetControls, simulatorModes, type SimulatorPreset } from "../simulator/modes";
import { createSimulator, demoOrigin, demoPath } from "../simulator/state";

/**
 * A small browser, driven by QueryWeave itself.
 *
 * The initial snapshot is produced at build time by the same `createSimulator` the browser uses,
 * so the server-rendered markup already shows real decoded state: no placeholder, no hydration
 * flash, and a complete demonstration even with scripting disabled. The client script only
 * attaches behavior to markup that is already correct.
 */

interface Props {
  readonly preset?: SimulatorPreset | undefined;
  readonly adapter?: string | undefined;
  readonly showInspector?: boolean | undefined;
  readonly showNavigation?: boolean | undefined;
  readonly initialQuery?: string | undefined;
  /** Rendered above the browser frame as the figure's purpose. */
  readonly caption?: string | undefined;
}

const {
  preset = "search",
  adapter = "browser",
  showInspector = true,
  showNavigation = true,
  initialQuery = "",
  caption,
} = Astro.props;

const controls = presetControls[preset];
const mode = findMode(adapter);

const simulator = createSimulator({ mode: mode.id, initialQuery });
const initial = simulator.snapshot();
simulator.dispose();

const statuses = ["all", "active", "archived"] as const;
const statusLabels: Record<string, string> = {
  all: "All",
  active: "Active",
  archived: "Archived",
};

const instance = Math.random().toString(36).slice(2, 8);
const searchId = `qw-sim-search-${instance}`;
const modeId = `qw-sim-mode-${instance}`;
const addressId = `qw-sim-address-${instance}`;
const rawId = `qw-sim-raw-${instance}`;

/**
 * Three outcomes, not two.
 *
 * `status` is `"invalid"` only when decoding could not produce usable values at all. A value that
 * was rejected and replaced by its default still decodes to `"valid"` — with an issue explaining
 * what happened — and that middle state is the one the documentation exists to teach, so it gets
 * its own label rather than being folded into either end.
 */
const validity = (status: string, issueCount: number): "invalid" | "recovered" | "valid" =>
  status === "invalid" ? "invalid" : issueCount > 0 ? "recovered" : "valid";

const validityLabels = {
  invalid: "Invalid",
  recovered: "Recovered",
  valid: "Valid",
} as const;

const initialValidity = validity(initial.status, initial.issues.length);
---

<figure class="simulator not-content qw-breakout">
  {caption !== undefined && <figcaption class="caption">{caption}</figcaption>}

  <qw-browser-simulator
    class="frame"
    data-preset={preset}
    data-mode={mode.id}
    data-initial-query={initialQuery}
  >
    <div class="chrome">
      <div class="chrome-dots" aria-hidden="true">
        <span class="chrome-dot chrome-dot--close"></span>
        <span class="chrome-dot chrome-dot--minimize"></span>
        <span class="chrome-dot chrome-dot--maximize"></span>
      </div>

      <div class="chrome-buttons">
        <button type="button" data-action="back" disabled aria-label="Back" title="Back">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path
              d="M8.5 3L4.5 7l4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <button type="button" data-action="forward" disabled aria-label="Forward" title="Forward">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path
              d="M5.5 3l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <button type="button" data-action="reload" aria-label="Reload" title="Reload">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path
              d="M11.5 7A4.5 4.5 0 1 1 7 2.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
            <path
              d="M7 2.5V5.5M7 2.5L9.5 2.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>

      {/* The query is editable because it is the subject of the page: a reader can type anything,
          including something the model rejects, and watch what decoding makes of it. Only the
          query is editable — the origin and path belong to the application, not to QueryWeave. */}
      <form class="address" data-address-form>
        <svg class="address-lock" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none">
          <rect x="2" y="5" width="8" height="6" rx="1" stroke="currentColor" stroke-width="1.2"></rect>
          <path
            d="M4 5V3.5a2 2 0 0 1 4 0V5"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"></path>
        </svg>
        {/* The host is split out so it can drop away on a phone, the way a mobile browser's
            address bar does, leaving the path and the query — the part this figure is about. */}
        <span class="address-origin" aria-hidden="true"
          ><span class="address-host">{demoOrigin}</span>{demoPath}</span
        >
        <span class="address-separator" aria-hidden="true">?</span>
        <label class="qw-sr-only" for={addressId}>Query string</label>
        <input
          id={addressId}
          class="address-query"
          data-query-input
          type="text"
          value={initial.rawQuery}
          placeholder="search=vue&page=2"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
        />
        <button type="submit" class="qw-sr-only">Go</button>
      </form>

      {
        showNavigation && (
          <p class="history" data-history>
            <span class="history-label">History</span>
            <span class="history-count" data-history-count>
              {mode.navigates
                ? `${String(initial.historyIndex + 1)} / ${String(initial.historyLength)}`
                : "—"}
            </span>
          </p>
        )
      }
    </div>

    <div class="viewport">
      <div class="page-head">
        <p class="page-title">Products</p>
        <p class="page-count" data-total>{initial.total} matching</p>
      </div>

      <label class="field" for={searchId}>
        <span>Search products</span>
        <span class="field-input-wrap">
          <svg class="field-icon" aria-hidden="true" width="15" height="15" viewBox="0 0 15 15" fill="none">
            <circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.4"></circle>
            <path d="M10 10l3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
          <input
            id={searchId}
            type="search"
            data-search
            value={initial.values.search ?? ""}
            placeholder="Try “vue”"
            autocomplete="off"
          />
        </span>
      </label>

      {
        controls.status && (
          <div class="chips" role="group" aria-label="Status filter">
            {statuses.map((status) => (
              <button
                type="button"
                data-status={status}
                aria-pressed={initial.values.status === status ? "true" : "false"}
              >
                {statusLabels[status]}
              </button>
            ))}
          </div>
        )
      }

      <ul class="results" data-results>
        {
          initial.rows.length === 0 ? (
            <li class="result-empty">
              <span>No products match the current filters.</span>
            </li>
          ) : (
            initial.rows.map((row) => (
              <li>
                <span class="result-name">{row.name}</span>
                <span class="result-meta">
                  <span class={`result-status result-status--${row.status}`}>{row.status}</span>
                  <span class="result-price">${row.price}</span>
                </span>
              </li>
            ))
          )
        }
      </ul>

      {
        controls.pagination && (
          <div class="pager">
            <button type="button" data-action="previous-page">
              Previous
            </button>
            <span data-page-label>
              Page {initial.values.page} of {initial.pageCount}
            </span>
            <button type="button" data-action="next-page">
              Next
            </button>
          </div>
        )
      }
    </div>

    <div class="controls">
      {
        showNavigation && (
          <fieldset class="navigation" data-navigation-control>
            <legend>Navigation</legend>
            <div class="segmented">
              {(["push", "replace"] as const).map((option) => (
                <label class="segmented-option">
                  <input
                    type="radio"
                    name={`qw-sim-navigation-${instance}`}
                    value={option}
                    checked={initial.navigation === option}
                  />
                  <span>{option === "push" ? "Push" : "Replace"}</span>
                </label>
              ))}
            </div>
          </fieldset>
        )
      }

      <div class="adapter">
        <label for={modeId}>Adapter</label>
        <select id={modeId} data-mode-select>
          {
            simulatorModes.map((option) => (
              <option value={option.id} selected={option.id === mode.id}>
                {option.label}
              </option>
            ))
          }
        </select>
      </div>

      <ul class="api" data-api>
        {initial.mode.api.map((entry) => <li>{entry}</li>)}
      </ul>

      <p class="mode-note" data-mode-note>{initial.mode.note}</p>
    </div>

    {
      showInspector && (
        <div class="inspector">
          {/* These three name fields, not document sections. As headings they put an `h4` under
              the page `h1` or `h2` on every page carrying a simulator, which is a broken outline
              for something the reader never navigates by. */}
          <section class="panel panel--raw">
            <label class="panel-label" for={rawId}>
              Raw query
            </label>
            <input
              id={rawId}
              class="raw-editor"
              data-query-input
              type="text"
              value={initial.rawQuery}
              placeholder="(empty)"
              spellcheck="false"
              autocomplete="off"
              autocapitalize="off"
              autocorrect="off"
            />
            <p class="hint">Type a query, press Enter.</p>
          </section>

          <section class="panel panel--typed">
            <p class="panel-label">Typed state</p>
            <pre data-typed>{JSON.stringify(initial.values, null, 2)}</pre>
          </section>

          <section class="panel panel--canonical">
            <div class="panel-head">
              <p class="panel-label">Canonical URL</p>
              {/* `data-validity`, not `data-status`: the status filter chips already carry
                  `data-status`, and they come first in the document. */}
              <span class="validity" data-validity data-state={initialValidity}>
                {validityLabels[initialValidity]}
              </span>
            </div>
            <code class="canonical-url" data-canonical>{initial.canonicalUrl}</code>
            <ul class="issues" data-issues>
              {
                initial.issues.map((issue) => (
                  <li>
                    <code>{issue.key}</code>
                    <span>{issue.message}</span>
                  </li>
                ))
              }
            </ul>
          </section>
        </div>
      )
    }

    <p class="qw-sr-only" role="status" data-announce></p>
  </qw-browser-simulator>
</figure>

<script>
  import type { SimulatorMode } from "../simulator/modes";
  import { createSimulator, type SimulatorSnapshot } from "../simulator/state";

  /**
   * DOM binding.
   *
   * All behavior lives in `createSimulator`, which is plain TypeScript over `@queryweave/core` and
   * `@queryweave/testing`. This class only writes snapshot values into elements that already exist,
   * so nothing here can disagree with the engine.
   */
  class QueryWeaveBrowserSimulator extends HTMLElement {
    private controller: ReturnType<typeof createSimulator> | undefined;
    private unsubscribe: (() => void) | undefined;
    private highlightDebounceTimer: ReturnType<typeof setTimeout> | undefined;
    private highlightFadeTimer: ReturnType<typeof setTimeout> | undefined;
    private announceTimer: ReturnType<typeof setTimeout> | undefined;

    connectedCallback(): void {
      const controller = createSimulator({
        mode: (this.dataset["mode"] ?? "browser") as SimulatorMode,
        initialQuery: this.dataset["initialQuery"] ?? "",
      });
      this.controller = controller;
      this.unsubscribe = controller.subscribe((snapshot) => {
        this.render(snapshot);
      });

      this.bind(controller);
      this.render(controller.snapshot());
    }

    disconnectedCallback(): void {
      this.unsubscribe?.();
      this.controller?.dispose();
      if (this.highlightDebounceTimer !== undefined) {
        clearTimeout(this.highlightDebounceTimer);
      }
      if (this.highlightFadeTimer !== undefined) {
        clearTimeout(this.highlightFadeTimer);
      }
      if (this.announceTimer !== undefined) {
        clearTimeout(this.announceTimer);
      }
    }

    private bind(controller: ReturnType<typeof createSimulator>): void {
      const search = this.querySelector<HTMLInputElement>("[data-search]");
      search?.addEventListener("input", () => {
        void controller.setSearch(search.value);
      });

      for (const chip of this.querySelectorAll<HTMLButtonElement>("[data-status]")) {
        chip.addEventListener("click", () => {
          const status = chip.dataset["status"];
          if (status === "all" || status === "active" || status === "archived") {
            void controller.setStatus(status);
          }
        });
      }

      const actions: Record<string, () => void> = {
        back: () => {
          controller.back();
        },
        forward: () => {
          controller.forward();
        },
        reload: () => {
          controller.reload();
        },
        "previous-page": () => {
          void controller.setPage(controller.snapshot().values.page - 1);
        },
        "next-page": () => {
          void controller.setPage(controller.snapshot().values.page + 1);
        },
      };

      for (const button of this.querySelectorAll<HTMLButtonElement>("[data-action]")) {
        const action = actions[button.dataset["action"] ?? ""];
        if (action !== undefined) {
          button.addEventListener("click", action);
        }
      }

      for (const radio of this.querySelectorAll<HTMLInputElement>('input[type="radio"]')) {
        radio.addEventListener("change", () => {
          if (radio.checked && (radio.value === "push" || radio.value === "replace")) {
            controller.setNavigation(radio.value);
          }
        });
      }

      const modeSelect = this.querySelector<HTMLSelectElement>("[data-mode-select]");
      modeSelect?.addEventListener("change", () => {
        controller.setMode(modeSelect.value as SimulatorMode);
      });

      this.bindQueryEditors(controller);
    }

    /**
     * The address bar and the raw query panel edit the same string.
     *
     * Neither holds state: both commit to the controller and then take whatever the next snapshot
     * says, so a reader sees the query they typed replaced by its normalized form rather than a
     * private copy that drifts from the URL.
     */
    private bindQueryEditors(controller: ReturnType<typeof createSimulator>): void {
      const editors = this.querySelectorAll<HTMLInputElement>("[data-query-input]");

      const commit = (input: HTMLInputElement): void => {
        const next = input.value.trim().replace(/^\?/u, "");
        if (next === controller.snapshot().rawQuery) {
          // Nothing changed, so nothing should reach the history stack.
          input.value = next;
          return;
        }
        void controller.setRawQuery(next);
      };

      for (const input of editors) {
        input.addEventListener("keydown", (event) => {
          if (event.key === "Enter") {
            event.preventDefault();
            commit(input);
          } else if (event.key === "Escape") {
            input.value = controller.snapshot().rawQuery;
            input.blur();
          }
        });
        input.addEventListener("blur", () => {
          commit(input);
        });
      }

      // Submitting the address form is the same operation; the button exists for keyboard and
      // assistive technology users who do not press Enter inside the field.
      this.querySelector<HTMLFormElement>("[data-address-form]")?.addEventListener(
        "submit",
        (event) => {
          event.preventDefault();
          const input = this.querySelector<HTMLInputElement>(".address-query");
          if (input !== null) {
            commit(input);
          }
        },
      );
    }

    private text(selector: string, value: string): void {
      const element = this.querySelector<HTMLElement>(selector);
      if (element !== null) {
        element.textContent = value;
      }
    }

    private render(snapshot: SimulatorSnapshot): void {
      for (const input of this.querySelectorAll<HTMLInputElement>("[data-query-input]")) {
        input.value = snapshot.rawQuery;
      }
      this.text("[data-typed]", JSON.stringify(snapshot.values, null, 2));
      this.text("[data-canonical]", snapshot.canonicalUrl);
      this.text("[data-total]", `${String(snapshot.total)} matching`);
      this.text(
        "[data-history-count]",
        snapshot.mode.navigates
          ? `${String(snapshot.historyIndex + 1)} / ${String(snapshot.historyLength)}`
          : "—",
      );
      this.text("[data-mode-note]", snapshot.mode.note);
      this.text("[data-page-label]", `Page ${String(snapshot.values.page)} of ${String(snapshot.pageCount)}`);

      const validity = this.querySelector<HTMLElement>("[data-validity]");
      if (validity !== null) {
        // Kept in step with the same three outcomes the server rendered.
        const state =
          snapshot.status === "invalid"
            ? "invalid"
            : snapshot.issues.length > 0
              ? "recovered"
              : "valid";
        validity.dataset["state"] = state;
        validity.textContent =
          state === "invalid" ? "Invalid" : state === "recovered" ? "Recovered" : "Valid";
      }

      const issues = this.querySelector<HTMLElement>("[data-issues]");
      if (issues !== null) {
        issues.replaceChildren(
          ...snapshot.issues.map((issue) => {
            const item = document.createElement("li");
            const key = document.createElement("code");
            key.textContent = issue.key;
            const message = document.createElement("span");
            message.textContent = issue.message;
            item.append(key, message);
            return item;
          }),
        );
      }

      const api = this.querySelector<HTMLElement>("[data-api]");
      if (api !== null) {
        api.replaceChildren(
          ...snapshot.mode.api.map((entry) => {
            const item = document.createElement("li");
            item.textContent = entry;
            return item;
          }),
        );
      }

      const results = this.querySelector<HTMLElement>("[data-results]");
      if (results !== null) {
        if (snapshot.rows.length === 0) {
          results.replaceChildren((() => {
            const item = document.createElement("li");
            item.className = "result-empty";
            const message = document.createElement("span");
            message.textContent = "No products match the current filters.";
            item.append(message);
            return item;
          })());
        } else {
          results.replaceChildren(
            ...snapshot.rows.map((row) => {
              const item = document.createElement("li");
              const name = document.createElement("span");
              name.className = "result-name";
              name.textContent = row.name;
              const meta = document.createElement("span");
              meta.className = "result-meta";
              const status = document.createElement("span");
              status.className = `result-status result-status--${row.status}`;
              status.textContent = row.status;
              const price = document.createElement("span");
              price.className = "result-price";
              price.textContent = `$${String(row.price)}`;
              meta.append(status, price);
              item.append(name, meta);
              return item;
            }),
          );
        }
      }

      for (const chip of this.querySelectorAll<HTMLButtonElement>("[data-status]")) {
        chip.setAttribute(
          "aria-pressed",
          String(chip.dataset["status"] === snapshot.values.status),
        );
      }

      const back = this.querySelector<HTMLButtonElement>('[data-action="back"]');
      const forward = this.querySelector<HTMLButtonElement>('[data-action="forward"]');
      if (back !== null) {
        back.disabled = !snapshot.canGoBack;
      }
      if (forward !== null) {
        forward.disabled = !snapshot.canGoForward;
      }

      const navigationControl = this.querySelector<HTMLFieldSetElement>("[data-navigation-control]");
      if (navigationControl !== null) {
        navigationControl.disabled = !snapshot.mode.navigates;
      }

      this.highlight(snapshot);
      this.announce(snapshot);
    }

    /**
     * Mark the panels a transition touched, then let the mark fade on its own.
     *
     * Search commits on every keystroke, so an undebounced highlight would flash the inspector
     * three times while someone types "vue". Waiting out the same pause the announce line uses
     * means the flash lands on the state the reader stopped on.
     */
    private highlight(snapshot: SimulatorSnapshot): void {
      if (snapshot.changedKeys.length === 0) {
        return;
      }

      const debounce =
        snapshot.changedKeys.length === 1 && snapshot.changedKeys[0] === "search";

      if (this.highlightDebounceTimer !== undefined) {
        clearTimeout(this.highlightDebounceTimer);
        this.highlightDebounceTimer = undefined;
      }

      if (debounce) {
        this.clearHighlight();
        this.highlightDebounceTimer = globalThis.setTimeout(() => {
          this.highlightDebounceTimer = undefined;
          this.applyHighlight();
        }, 500);
        return;
      }

      this.applyHighlight();
    }

    private clearHighlight(): void {
      if (this.highlightFadeTimer !== undefined) {
        clearTimeout(this.highlightFadeTimer);
        this.highlightFadeTimer = undefined;
      }
      for (const panel of this.querySelectorAll<HTMLElement>(".panel")) {
        panel.classList.remove("panel--changed");
      }
    }

    private applyHighlight(): void {
      for (const panel of this.querySelectorAll<HTMLElement>(".panel")) {
        panel.classList.add("panel--changed");
      }
      if (this.highlightFadeTimer !== undefined) {
        clearTimeout(this.highlightFadeTimer);
      }
      this.highlightFadeTimer = globalThis.setTimeout(() => {
        this.highlightFadeTimer = undefined;
        this.clearHighlight();
      }, 900);
    }

    /**
     * The status line waits for the reader to stop.
     *
     * The product search commits on every keystroke, so an undebounced live region reads a whole
     * URL, a result count, and a history position three times while someone types "vue" — each
     * one interrupting the last. Waiting out a pause costs a keyboard user nothing, because a
     * polite region would not have spoken until the next gap anyway, and it means what they hear
     * is the state they stopped on rather than the states they passed through.
     */
    private announce(snapshot: SimulatorSnapshot): void {
      if (this.announceTimer !== undefined) {
        clearTimeout(this.announceTimer);
      }
      this.announceTimer = globalThis.setTimeout(() => {
        const history = snapshot.mode.navigates
          ? `History entry ${String(snapshot.historyIndex + 1)} of ${String(snapshot.historyLength)}.`
          : "Request-scoped: no history.";
        const recovery =
          snapshot.issues.length === 0
            ? ""
            : ` Recovered ${String(snapshot.issues.length)} value${snapshot.issues.length === 1 ? "" : "s"}: ${snapshot.issues.map((issue) => `${issue.key} — ${issue.message}`).join("; ")}.`;
        this.text(
          "[data-announce]",
          `${snapshot.canonicalUrl}. ${String(snapshot.total)} results. ${history}${recovery}`,
        );
      }, 500);
    }
  }

  if (customElements.get("qw-browser-simulator") === undefined) {
    customElements.define("qw-browser-simulator", QueryWeaveBrowserSimulator);
  }
</script>

<style>
  .simulator {
    margin-block: 2rem;
  }

  .caption {
    margin: 0 0 0.75rem;
    color: var(--qw-muted);
    font-size: var(--qw-text-small);
  }

  .frame {
    display: block;
    border: 1px solid var(--qw-panel-border-strong);
    border-radius: var(--qw-radius-lg);
    background: var(--qw-panel);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--qw-heading) 4%, transparent),
      0 8px 24px color-mix(in srgb, var(--qw-heading) 6%, transparent);
    overflow: hidden;
  }

  /* ------------------------------------------------------------- chrome */

  .chrome {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border-bottom: 1px solid var(--qw-panel-border);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--qw-code-chrome) 92%, var(--qw-heading)) 0%,
      var(--qw-code-chrome) 100%
    );
    padding: 0.55rem 0.85rem;
  }

  .chrome-dots {
    display: flex;
    gap: 0.35rem;
    flex: none;
    padding-inline-end: 0.15rem;
  }

  .chrome-dot {
    display: block;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    opacity: 0.85;
  }

  .chrome-dot--close {
    background: #ff5f57;
  }

  .chrome-dot--minimize {
    background: #febc2e;
  }

  .chrome-dot--maximize {
    background: #28c840;
  }

  .chrome-buttons {
    display: flex;
    gap: 0.15rem;
    flex: none;
    border: 1px solid var(--qw-panel-border);
    border-radius: var(--qw-radius-sm);
