---
import type { DiagramEdge, DiagramNode } from "../diagrams/types";
import DiagramFigure from "./DiagramFigure.astro";

/**
 * How every environment reaches the engine.
 *
 * The figure stays within a documentation column: four stages across, environments stacked on
 * the right. Framework bindings such as Vue Router or Nuxt sit on top of these adapters in
 * their own pages rather than in this map.
 */

interface Props {
  readonly caption?: string | undefined;
}

const { caption } = Astro.props;

const nodes: readonly DiagramNode[] = [
  {
    id: "model",
    label: "Query Model",
    note: "parameters, codecs, defaults",
    tone: "core",
    col: 0,
    row: 0,
    rowSpan: 3,
  },
  {
    id: "decode",
    label: "decode",
    note: "raw query → typed state",
    tone: "operation",
    col: 1,
    row: 0,
    rowSpan: 2,
  },
  {
    id: "encode",
    label: "encode",
    note: "typed state → canonical query",
    tone: "operation",
    col: 1,
    row: 2,
    rowSpan: 1,
  },
  {
    id: "runtime",
    label: "Query Runtime",
    note: "encode once, navigate once, notify once",
    tone: "core",
    col: 2,
    row: 0,
    rowSpan: 3,
  },
  {
    id: "browser",
    label: "Browser",
    note: "History API",
    tone: "environment",
    col: 3,
    row: 0,
  },
  {
    id: "server",
    label: "Server",
    note: "Request and URL",
    tone: "environment",
    col: 3,
    row: 1,
  },
  {
    id: "testing",
    label: "Testing",
    note: "memory stack",
    tone: "environment",
    col: 3,
    row: 2,
  },
];

const edges: readonly DiagramEdge[] = [
  { from: "model", to: "decode", active: true },
  { from: "model", to: "encode", active: true },
  { from: "decode", to: "runtime", tone: "core" },
  { from: "encode", to: "runtime", tone: "core" },
  { from: "runtime", to: "browser" },
  { from: "runtime", to: "server" },
  { from: "runtime", to: "testing" },
];
---

<DiagramFigure
  nodes={nodes}
  edges={edges}
  orientation="horizontal"
  unit={148}
  gapX={36}
  gapY={16}
  caption={caption}
  label="Every environment reaches the engine through the same model and runtime."
/>
