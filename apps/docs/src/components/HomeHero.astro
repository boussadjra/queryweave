---
import { currentPackageVersion } from "../data/release";
---

<section class="hero not-content">
  <div class="copy">
    <h1>
      Type-safe URL state,<br />
      <span>woven together.</span>
    </h1>

    <p class="lede">
      Define your query model once. Decode, validate, encode, synchronize, and reuse it across
      browsers, servers, Node.js, and framework adapters.
    </p>

    <div class="actions">
      <a class="qw-btn qw-btn--primary" href="/start/">Get started</a>
      <a class="qw-btn qw-btn--secondary" href="/project/architecture/">Explore the architecture</a>
    </div>

    <p class="install">
      <code>pnpm add @queryweave/core</code>
      <span class="install-note">v{currentPackageVersion} is the current source version</span>
    </p>
  </div>

  <figure class="stages" aria-labelledby="query-lifecycle-title">
    <figcaption>
      <span id="query-lifecycle-title">Query lifecycle</span>
      <small>One model keeps every boundary in step.</small>
    </figcaption>

    <ol class="stage-list">
      <li class="stage">
        <span class="stage-marker" aria-hidden="true">1</span>
        <div class="stage-copy">
          <span class="stage-label">Raw query</span>
          <code>?search=vue&page=2</code>
        </div>
      </li>
      <li class="stage" data-operation="decode">
        <span class="qw-sr-only">Decode into</span>
        <span class="stage-marker" aria-hidden="true">2</span>
        <div class="stage-copy">
          <span class="stage-label">Typed state</span>
          <code>{`{ search: "vue", page: 2 }`}</code>
        </div>
      </li>
      <li class="stage" data-operation="encode">
        <span class="qw-sr-only">Encode into</span>
        <span class="stage-marker" aria-hidden="true">3</span>
        <div class="stage-copy">
          <span class="stage-label">Canonical query</span>
          <code>search=vue&page=2</code>
        </div>
      </li>
    </ol>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    gap: 2.5rem 3rem;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    padding-block: 1rem 2.5rem;
  }

  h1 {
    margin: 0;
    color: var(--qw-heading-brand);
    font-size: var(--qw-text-hero);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .lede {
    max-width: 34rem;
    margin: 1.35rem 0 0;
    color: var(--qw-body);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .install {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem;
    margin: 1.75rem 0 0;
  }

  .install code {
    border: 1px solid var(--qw-panel-border);
    border-radius: var(--qw-radius-sm);
    background: var(--qw-panel);
    padding: 0.35rem 0.7rem;
    color: var(--qw-body);
    font-family: var(--qw-font-mono);
    font-size: var(--qw-text-small);
  }

  .install-note {
    color: var(--qw-muted);
    font-size: var(--qw-text-label);
  }

  /* ------------------------------------------------------------- stages */

  .stages {
    overflow: hidden;
    border: 1px solid var(--qw-panel-border);
    border-radius: var(--qw-radius-lg);
    background: var(--qw-panel);
    margin: 0;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--qw-panel-border);
    padding: 1rem 1.1rem;
  }

  figcaption > span {
    color: var(--qw-heading);
    font-weight: 600;
  }

  figcaption small {
    max-width: 18rem;
    color: var(--qw-muted);
    font-size: var(--qw-text-label);
    line-height: 1.5;
    text-align: end;
  }

  .stage-list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.45rem;
    list-style: none;
    padding: 1.15rem;
    margin: 0;
  }

  .stage-list::before {
    content: "";
    position: absolute;
    inset-block: 2rem;
    inset-inline-start: 2.25rem;
    width: 1px;
    background: var(--qw-panel-border-strong);
  }

  .stage {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
  }

  .stage:not(:first-child)::before {
    content: attr(data-operation);
    position: absolute;
    inset-block-start: -1.2rem;
    inset-inline-start: 3.05rem;
    color: var(--qw-technical);
    font-family: var(--qw-font-mono);
    font-size: 0.6875rem;
  }

  .stage-marker {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--qw-panel-border-strong);
    border-radius: 50%;
    background: var(--qw-panel-raised);
    color: var(--qw-heading);
    font-family: var(--qw-font-mono);
    font-size: var(--qw-text-label);
    font-weight: 600;
  }

  .stage:first-child .stage-marker {
    border-color: var(--qw-path-runtime);
    color: var(--qw-technical);
  }

  .stage:nth-child(2) .stage-marker {
    border-color: var(--qw-path-core);
    color: var(--qw-accent);
  }

  .stage:last-child .stage-marker {
    border-color: var(--qw-path-valid);
    color: var(--qw-valid);
  }

  .stage-copy {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    border-radius: var(--qw-radius-sm);
    background: var(--qw-panel-raised);
    padding: 0.75rem 0.9rem;
  }

  .stage-label {
    color: var(--qw-muted);
    font-size: var(--qw-text-label);
  }

  .stage code {
    color: var(--qw-body);
    font-family: var(--qw-font-mono);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 62rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .lede {
      max-width: none;
    }
  }

  @media (max-width: 32rem) {
    .hero {
      padding-block-start: 0;
    }

    h1 {
      font-size: clamp(2.25rem, 12vw, 3rem);
    }

    figcaption {
      flex-direction: column;
      gap: 0.25rem;
    }

    figcaption small {
      text-align: start;
    }
  }
</style>
